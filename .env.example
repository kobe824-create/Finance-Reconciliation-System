
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Used only by `npm run db:seed-admin` to create or promote the platform super administrator.
# If omitted, the email address is also used as the username.
BOOTSTRAP_SUPERADMIN_USERNAME=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
